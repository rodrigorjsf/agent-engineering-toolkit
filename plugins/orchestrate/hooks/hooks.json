{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/orchestrate-mcp/dist/context-watchdog.js\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
